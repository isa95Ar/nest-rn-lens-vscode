{
  "name": "nest-rn-lens",
  "displayName": "NestRN Lens",
  "description": "See the live traffic between your React Native app and your NestJS API, inside a Turborepo.",
  "version": "0.1.0",
  "publisher": "IsaiasDiaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isa95Ar/nest-rn-lens-vscode.git"
  },
  "homepage": "https://github.com/isa95Ar/nest-rn-lens-vscode#readme",
  "bugs": {
    "url": "https://github.com/isa95Ar/nest-rn-lens-vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0b0f",
    "theme": "dark"
  },
  "keywords": [
    "react native",
    "expo",
    "nestjs",
    "nest",
    "turborepo",
    "monorepo",
    "api",
    "traffic",
    "network",
    "devtools"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nestRnLens",
          "title": "NestRN Lens",
          "icon": "media/nest-rn-lens.svg"
        }
      ]
    },
    "views": {
      "nestRnLens": [
        {
          "type": "webview",
          "id": "nestRnLens.home",
          "name": "Setup"
        }
      ]
    },
    "commands": [
      {
        "command": "nestRnLens.revalidate",
        "title": "Re-check workspace",
        "category": "NestRN Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "nestRnLens.start",
        "title": "Launch session",
        "category": "NestRN Lens",
        "icon": "$(play)"
      },
      {
        "command": "nestRnLens.stop",
        "title": "Stop session",
        "category": "NestRN Lens",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nestRnLens.revalidate",
          "when": "view == nestRnLens.home",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "NestRN Lens",
      "properties": {
        "nestRnLens.apiPort": {
          "type": "number",
          "default": 3000,
          "description": "Port the NestJS API listens on."
        },
        "nestRnLens.metroPort": {
          "type": "number",
          "default": 8081,
          "description": "Port for the Metro bundler (Expo dev server)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "nestRnLens",
        "properties": {}
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
