{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "dist",
		"lib": ["ES2022"],
		"types": ["node", "vscode"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["src/webview"]
}
